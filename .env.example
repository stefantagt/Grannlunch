# Kopiera till .env.local när Supabase ska kopplas in.
# Använd bara den publika anon-nyckeln i frontend. Lägg aldrig en service role-nyckel här.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lämna tom eller sätt till / för en egen domän och för lokal utveckling.
# På en GitHub-projektsida utan egen domän, sätt till /Grannlunch/
VITE_BASE_PATH=/
